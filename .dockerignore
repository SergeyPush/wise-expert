# Тяжёлое и/или платформозависимое. node_modules собирается внутри образа:
# нативные модули (sharp, next-swc) собраны под хост-платформу и в linux-
# контейнере не работают, а `COPY . .` затирал бы ими установленные
node_modules
.next
out
build

.git
.github
.gitignore

# Локальные артефакты инструментов
.claude
.agents
.playwright*
.idea
.vscode
.DS_Store
*.tsbuildinfo
coverage

# Секреты: .env приходит в контейнер через env_file в docker-compose,
# в образ попадать не должен
.env
.env*.local
*.pem

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Заметки и черновики, к сборке отношения не имеют
*.md
!README.md
learning-records
lessons
reference
